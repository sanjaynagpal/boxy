#!/usr/bin/env python3
"""ansible-boxcar: seal files and folders into a bundle for the
sanjaynagpal.boxcar Ansible collection, and inspect existing bundles.

  ansible-boxcar seal BUNDLE PATH [PATH ...] [--mode PATTERN=MODE ...] [--force]
  ansible-boxcar unbox BUNDLE DEST [--entry NAME ...] [--force]
  ansible-boxcar list BUNDLE

`seal` prompts for the bundle password (twice) on the terminal. For
unattended testing only, $BOXCAR_PASSWORD supplies it instead.

`unbox` decrypts a bundle into DEST on this machine (for recovery,
inspection or manual use), with the modes recorded in the bundle. Nothing is
written unless the password and every entry check out, and existing files
are never overwritten without --force.

A file PATH is stored under its base name; a directory PATH is walked
recursively and each file is stored under its path relative to that
directory. Entries default to mode 0600; use --mode to override by
fnmatch pattern on the entry name (first match wins), e.g.
  --mode '*.pem=0644' --mode '*.key=0600'
"""
from __future__ import annotations

import argparse
import fnmatch
import getpass
import os
import sys
import tempfile

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(
    _HERE, os.pardir, "collections", "ansible_collections", "sanjaynagpal", "boxcar",
    "plugins", "module_utils"))

import bundle  # noqa: E402


def _read_password(confirm: bool) -> bytes:
    env = os.environ.get("BOXCAR_PASSWORD")
    if env:
        return env.encode("utf-8")
    first = getpass.getpass("Bundle password: ")
    if confirm and getpass.getpass("Confirm password: ") != first:
        raise bundle.BundleError("passwords do not match")
    return first.encode("utf-8")


def _collect(paths, mode_rules):
    entries = []
    for path in paths:
        if os.path.isdir(path):
            sources = []
            for root, dirs, files in os.walk(path):
                dirs.sort()
                for fname in sorted(files):
                    full = os.path.join(root, fname)
                    if os.path.isfile(full):
                        rel = os.path.relpath(full, path).replace(os.sep, "/")
                        sources.append((rel, full))
        elif os.path.isfile(path):
            sources = [(os.path.basename(path), path)]
        else:
            raise bundle.BundleError("no such file or folder: %s" % path)
        if not sources:
            raise bundle.BundleError("folder %s contains no files" % path)
        for name, full in sources:
            with open(full, "rb") as fh:
                data = fh.read()
            mode = next((m for pat, m in mode_rules if fnmatch.fnmatchcase(name, pat)),
                        bundle.DEFAULT_MODE)
            entries.append(bundle.Entry(name, mode, data))
    return entries


def _parse_mode_rule(text):
    pattern, sep, mode = text.partition("=")
    if not sep or not pattern:
        raise argparse.ArgumentTypeError("expected PATTERN=MODE, got %r" % text)
    try:
        return pattern, bundle.parse_mode(mode)
    except bundle.BundleError as exc:
        raise argparse.ArgumentTypeError(str(exc)) from None


def cmd_seal(args) -> int:
    if os.path.exists(args.bundle) and not args.force:
        raise bundle.BundleError("%s already exists (use --force to replace it)" % args.bundle)
    entries = _collect(args.paths, args.mode)
    password = _read_password(confirm=True)
    if bundle.is_weak_password(password):
        print("warning: password is shorter than %d characters; a longer passphrase is "
              "recommended" % bundle.RECOMMENDED_PASSWORD_LEN, file=sys.stderr)
    bundle.save(args.bundle, bundle.seal(entries, password))
    print("sealed %d file(s) into %s" % (len(entries), args.bundle))
    return 0


def _write_file(path, data, mode, force) -> None:
    """Write data to path with the given mode, via a temp file in its directory."""
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    if os.path.islink(path) or os.path.islink(directory):
        raise bundle.BundleError("refusing to write through a symlink: %s" % path)
    if os.path.exists(path) and not force:
        raise bundle.BundleError("%s already exists (use --force to replace it)" % path)
    fd, tmp = tempfile.mkstemp(prefix=".boxcar-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def cmd_unbox(args) -> int:
    doc = bundle.load(args.bundle)
    entries = bundle.open_bundle(doc, _read_password(confirm=False))  # all-or-nothing
    if args.entry:
        missing = sorted(set(args.entry) - {e.name for e in entries})
        if missing:
            raise bundle.BundleError("not in bundle: %s" % ", ".join(missing))
        entries = [e for e in entries if e.name in set(args.entry)]
    dest = os.path.abspath(args.dest)
    targets = [(e, os.path.join(dest, *e.name.split("/"))) for e in entries]
    if not args.force:  # refuse before writing anything, not halfway through
        clash = [path for _, path in targets if os.path.exists(path)]
        if clash:
            raise bundle.BundleError("%s already exists (use --force to replace it)" % clash[0])
    os.makedirs(dest, mode=0o700, exist_ok=True)
    for entry, path in targets:
        _write_file(path, entry.data, entry.mode, args.force)
    print("unboxed %d file(s) into %s" % (len(targets), dest))
    return 0


def cmd_list(args) -> int:
    for name, mode in bundle.list_entries(bundle.load(args.bundle)):
        print("%04o  %s" % (mode, name))
    return 0


TOP_DESCRIPTION = """Seal keys, certificates and PEM files into a password-protected bundle for the
sanjaynagpal.boxcar Ansible collection, and inspect or recover existing
bundles. A bundle is safe to keep at rest and to commit to Git; install it on
hosts with the sanjaynagpal.boxcar.unbox module (see docs/USER-GUIDE.md).
"""

TOP_EPILOG = """examples:
  ansible-boxcar seal files/tls.box ./certs --mode '*.crt=0644'
  ansible-boxcar list files/tls.box
  ansible-boxcar unbox files/tls.box ./recovered --entry server.crt

Run "ansible-boxcar COMMAND --help" for the details of one command.

environment:
  BOXCAR_PASSWORD   use this password instead of prompting (for tests and
                    automation only; the value is visible to anything that can
                    read this process's environment)

exit status: 0 success, 1 error (message on stderr), 2 usage error.
"""

SEAL_DESCRIPTION = """Encrypt files and folders into one bundle. The password is asked twice.

Each PATH is either a file, stored under its base name, or a folder, searched
recursively with every file stored under its path relative to that folder.
Entries default to file mode 0600; use --mode to give matching names another
mode. The bundle is never overwritten unless you pass --force.
"""

SEAL_EPILOG = """--mode details:
  PATTERN is a shell-style pattern matched against the entry name (for example
  '*.crt' or 'client/client.key'); MODE is octal (0600, 0644, ...). Rules are
  checked in the order given and the first match wins, so put specific
  patterns before a catch-all such as '*'.

examples:
  ansible-boxcar seal tls.box server.key server.crt --mode '*.crt=0644'
  ansible-boxcar seal pki.box ./pki --mode 'client/client.key=0600' --mode '*=0644'
  ansible-boxcar seal tls.box ./certs --force      # replace an existing bundle

Passwords must be at least 8 characters; 16 or more is recommended.
"""

UNBOX_DESCRIPTION = """Decrypt a bundle into a local folder, for recovery or inspection (Ansible
deployments use the sanjaynagpal.boxcar.unbox module instead). The password is
asked once.

Files are written with the modes recorded in the bundle. Nothing is written
unless the password and every entry check out, and existing files are never
overwritten unless you pass --force. DEST is created (mode 0700) if missing.
"""

UNBOX_EPILOG = """examples:
  ansible-boxcar unbox tls.box ./recovered
  ansible-boxcar unbox tls.box ./recovered --entry server.crt --entry server.key
  ansible-boxcar unbox tls.box ./recovered --force

Treat DEST as sensitive and delete it when you are done. Use
"ansible-boxcar list BUNDLE" to see the entry names to pass to --entry.
"""

LIST_DESCRIPTION = """Print each entry's mode and name, one per line. No password is needed: names
and modes are stored in the clear (only file contents are encrypted).
"""


def build_parser() -> argparse.ArgumentParser:
    raw = argparse.RawDescriptionHelpFormatter
    parser = argparse.ArgumentParser(
        prog="ansible-boxcar", description=TOP_DESCRIPTION, epilog=TOP_EPILOG,
        formatter_class=raw)
    sub = parser.add_subparsers(dest="cmd", metavar="COMMAND", title="commands")

    p_seal = sub.add_parser(
        "seal", help="encrypt files/folders into a bundle (prompts for a password)",
        formatter_class=raw,
        description=SEAL_DESCRIPTION, epilog=SEAL_EPILOG)
    p_seal.add_argument("bundle", metavar="BUNDLE",
                        help="bundle file to create, e.g. files/tls.box")
    p_seal.add_argument("paths", nargs="+", metavar="PATH",
                        help="file or folder to include (one or more)")
    p_seal.add_argument("--mode", action="append", default=[], type=_parse_mode_rule,
                        metavar="PATTERN=MODE",
                        help="file mode for entry names matching PATTERN; repeatable, "
                             "first match wins (default 0600)")
    p_seal.add_argument("--force", action="store_true",
                        help="replace BUNDLE if it already exists")
    p_seal.set_defaults(func=cmd_seal)

    p_unbox = sub.add_parser(
        "unbox", help="decrypt a bundle into a local folder (prompts for a password)",
        formatter_class=raw,
        description=UNBOX_DESCRIPTION, epilog=UNBOX_EPILOG)
    p_unbox.add_argument("bundle", metavar="BUNDLE", help="bundle file to open")
    p_unbox.add_argument("dest", metavar="DEST",
                         help="folder to write the files into (created if missing)")
    p_unbox.add_argument("--entry", action="append", default=[], metavar="NAME",
                         help="only extract this entry; repeatable (default: all)")
    p_unbox.add_argument("--force", action="store_true",
                         help="overwrite files that already exist in DEST")
    p_unbox.set_defaults(func=cmd_unbox)

    p_list = sub.add_parser(
        "list", help="list entry names and modes (no password needed)",
        formatter_class=raw, description=LIST_DESCRIPTION)
    p_list.add_argument("bundle", metavar="BUNDLE", help="bundle file to inspect")
    p_list.set_defaults(func=cmd_list)
    return parser


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not args.cmd:
        parser.print_help(sys.stderr)
        return 2
    try:
        return args.func(args)
    except bundle.BundleError as exc:
        print("error:", exc, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
